# ==============================================================================
# 外贸询盘助手 - 环境配置示例文件 (.env.example)
#
# 使用指南：
# 1. 本地独立运行：复制本文件为 .env，并修改其中的密钥和参数；
# 2. 推荐三库隔离架构：将真实的 .env 存放在同级目录「外贸询盘助手-保密数据/.env」，
#    本程序将自动探测并安全挂载，无需将真实密钥留在本代码库中！
# ==============================================================================

# ============ Web 服务配置 ============
MB_HOST=127.0.0.1
MB_PORT=8090
# Session 鉴权密钥 (请替换为随机长字符串)
MB_SECRET_KEY=change_me_to_a_random_secret_string_32_bytes_or_more
MB_ADMIN_USER=admin
# 管理员密码 PBKDF2 哈希值 (通过 python -c "import hashlib..." 生成)
MB_ADMIN_PASS_HASH=pbkdf2_sha256$600000$example_salt$example_hash=
MB_SESSION_TTL=43200

# ============ 凭据加密口令 ============
# 用于加密本地保存的邮箱授权码、IMAP/SMTP 密码 (AES-256)
MB_CRED_KEY=change_me_to_another_random_secret_string

# ============ 邮件自动化引擎 ============
MB_POLL_INTERVAL=60
MB_MAX_FETCH=50
MB_LOOKBACK_DAYS=7
MB_AUTO_SEND=0
MB_TZ_OFFSET=8

# ============ AI 大模型配置 ============
MB_AI_BASE_URL=https://api.deepseek.com
MB_AI_API_KEY=your_deepseek_api_key_here
MB_AI_MODEL=deepseek-chat
MB_AI_TIMEOUT=60
MB_AI_FALLBACK=1
MB_HIGH_INTENT=70

# ============ 路径覆盖（可选） ============
# 若需指定非默认的数据金库路径，可配置以下变量：
# MB_VAULT_DIR=../外贸询盘助手-保密数据
# MB_DATA_DIR=../外贸询盘助手-保密数据/data
